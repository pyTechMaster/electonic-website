PORT=3000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/tinkerleaf?retryWrites=true&w=majority
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret
NODE_ENV=development
# Production: set NODE_ENV=production (secure cookies) and TRUST_PROXY=1 when hosted behind Render/Railway/Heroku/Nginx
TRUST_PROXY=
CLIENT_ORIGIN=http://localhost:3000

# Razorpay - keep SECRET only on the server
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Email (SMTP). Gmail: use an App Password, not your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM="Tinkerleaf <your-email@gmail.com>"
ADMIN_EMAIL=your-email@gmail.com

# Customer account security
# New accounts must verify their email. Existing accounts without this field are treated as verified.
PASSWORD_RESET_MINUTES=30
EMAIL_VERIFICATION_HOURS=24

# Invoice / GST
# Set the applicable GST rate for your products. Keep this configurable because GST rates can differ by product.
GST_RATE=18
GST_INCLUDED=true
BUSINESS_NAME=Tinkerleaf
BUSINESS_ADDRESS=Ahmedabad, Gujarat, India

# Delivery pincode checking
# all_india = every valid 6-digit Indian pincode is considered serviceable.
# whitelist = only DELIVERY_PINCODES / DELIVERY_PIN_PREFIXES are serviceable.
DELIVERY_MODE=all_india
DELIVERY_PINCODES=
DELIVERY_PIN_PREFIXES=

# Razorpay webhooks (set this same secret in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Paid-but-no-order safety net: if a payment is captured but the order was never saved, it is auto-refunded after this many minutes (min 5)
ORPHAN_REFUND_AFTER_MINUTES=30
# Shown on invoices (optional)
BUSINESS_GSTIN=

# Phase 8: email verification for new accounts.
# true  (default) = a new customer must click the link in the verification email before signing in (needs SMTP above).
# false           = account works immediately after sign-up (use this if you have not set up SMTP / Gmail yet).
REQUIRE_EMAIL_VERIFICATION=true
